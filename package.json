{
  "name": "verilog-signal-trace",
  "displayName": "Verilog Signal Trace",
  "description": "Trace Verilog and SystemVerilog signals through assignments, write conditions, and named ports. Explore dependencies in an interactive graph.",
  "version": "0.8.2",
  "publisher": "ZoraJack",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Programming Languages"],
  "keywords": ["Verilog", "SystemVerilog", "RTL", "FPGA", "signal tracing"],
  "repository": { "type": "git", "url": "https://github.com/Zora-Jack/Verilog_signal_extension.git" },
  "files": ["extension.js", "signals.js", "project.js", "graph.js", "graph-panel.js", "webview/graph.js", "webview/graph.css", "MARKETPLACE.md"],
  "vsce": { "readmePath": "MARKETPLACE.md", "dependencies": false },
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "verilog-signal-trace.directRelations", "title": "Verilog：查看直接上下游", "enablement": "editorLangId == verilog || editorLangId == systemverilog" },
      { "command": "verilog-signal-trace.tracePath", "title": "Verilog：多级追踪信号", "enablement": "editorLangId == verilog || editorLangId == systemverilog" },
      { "command": "verilog-signal-trace.graph", "title": "Verilog：绘制上下游关系图", "enablement": "editorLangId == verilog || editorLangId == systemverilog" }
    ],
    "menus": {
      "editor/context": [
        { "command": "verilog-signal-trace.directRelations", "when": "editorLangId == verilog || editorLangId == systemverilog", "group": "navigation@5" },
        { "command": "verilog-signal-trace.tracePath", "when": "editorLangId == verilog || editorLangId == systemverilog", "group": "navigation@6" },
        { "command": "verilog-signal-trace.graph", "when": "editorLangId == verilog || editorLangId == systemverilog", "group": "navigation@7" }
      ]
    },
    "languages": [
      { "id": "verilog", "extensions": [".v", ".vh"] },
      { "id": "systemverilog", "extensions": [".sv", ".svh"] }
    ]
  },
  "activationEvents": ["onLanguage:verilog", "onLanguage:systemverilog"]
}
